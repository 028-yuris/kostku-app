          "body": "<!DOCTYPE html>\n<html lang=\"id\">\n    <head>\n        <meta charset=\"UTF-8\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n        <meta name=\"description\" content=\"Sistem Informasi Laboratorium Universitas Madura telah berpindah ke ATLAS\" />\n        <meta http-equiv=\"refresh\" content=\"12;url=https://atlas.unira.ac.id\" />\n        <link rel=\"icon\" type=\"image/png\" href=\"/assets/images/atlas.png\" />\n        <title>SILAB berpindah ke ATLAS | UNIRA</title>\n        <script src=\"https://cdn.tailwindcss.com\"></script>\n    </head>\n    <body class=\"min-h-screen bg-gradient-to-br from-slate-950 via-[#3b2b17] to-amber-900 flex items-center justify-center p-5 font-sans\">\n        <main class=\"w-full max-w-lg rounded-3xl bg-white/95 shadow-2xl ring-1 ring-black/10 overflow-hidden\">\n            <div class=\"h-1.5 w-full bg-slate-200\">\n                <div id=\"bar\" class=\"h-full w-0 bg-gradient-to-r from-amber-500 to-emerald-500 transition-[width] duration-1000 ease-linear\"></div>\n            </div>\n            <div class=\"px-8 py-9 text-center\">\n                <div class=\"flex items-center justify-center gap-4\">\n                    <img src=\"/assets/images/logo-unira.png\" alt=\"Logo UNIRA\" class=\"h-16 w-16 object-contain\" />\n                    <svg class=\"h-6 w-6 text-slate-400\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                        <path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n                    </svg>\n                    <img src=\"/assets/images/atlas.png\" alt=\"Logo ATLAS\" class=\"h-16 w-16 object-contain\" />\n                </div>\n                <p class=\"mt-5 text-[11px] font-bold uppercase tracking-[0.22em] text-amber-700\">Pemberitahuan Sistem</p>\n                <h1 class=\"mt-2 text-2xl font-extrabold tracking-tight text-slate-900\">SILAB telah berpindah ke ATLAS</h1>\n                <p class=\"mt-3 text-sm leading-relaxed text-slate-600\">\n        Layanan di \n                    <span class=\"font-mono font-semibold text-slate-800\">silab.ft.unira.ac.id</span>\n        sudah dialihkan ke alamat baru\n                    <span class=\"font-mono font-semibold text-emerald-700\">atlas.unira.ac.id</span>.\n        Silakan perbarui bookmark Anda.\n                </p>\n                <div class=\"mt-5 inline-flex items-center gap-2.5 rounded-full bg-slate-100 px-5 py-2.5\">\n                    <span class=\"relative flex h-2.5 w-2.5\">\n                        <span class=\"animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75\"></span>\n                        <span class=\"relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500\"></span>\n                    </span>\n                    <p class=\"text-sm text-slate-600\">Mengalihkan otomatis dalam \n                        <strong id=\"count\" class=\"font-mono text-slate-900\">10</strong> detik…\n                    </p>\n                </div>\n                <div class=\"mt-6\">\n                    <a href=\"https://atlas.unira.ac.id\"\n           class=\"inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-600 to-amber-700 px-5 py-3.5 text-sm font-bold text-white shadow-lg shadow-amber-900/20 transition hover:brightness-110\">\n          Lanjut ke ATLAS Sekarang\n          \n                        <svg class=\"h-4 w-4\" viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\">\n                            <path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n                        </svg>\n                    </a>\n                    <p class=\"mt-3 text-xs text-slate-400\">Jika tidak berpindah otomatis, tekan tombol di atas.</p>\n                </div>\n            </div>\n            <div class=\"border-t border-slate-100 bg-slate-50 px-8 py-3.5 text-center text-[11px] text-slate-400\">\n      Universitas Madura &bull; Academic Technical Laboratory Administration System\n    </div>\n        </main>\n        <script>\n    (function () {\n      var target = 'https://atlas.unira.ac.id';\n      var remain = 10;\n      var countEl = document.getElementById('count');\n      var barEl = document.getElementById('bar');\n      function tick() {\n        remain -= 1;\n        if (remain <= 0) {\n          window.location.replace(target);\n          return;\n        }\n        if (countEl) countEl.textContent = remain;\n        if (barEl) barEl.style.width = ((10 - remain) * 10) + '%';\n        setTimeout(tick, 1000);\n      }\n      if (barEl) barEl.style.width = '0%';\n      setTimeout(tick, 1000);\n    })();\n  \n        </script>\n    </body>\n</html>"
        }
      ]
